{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "expo-secure-store": [
        "./types/expo-secure-store/index"
      ],
      "expo-router": [
        "./node_modules/expo-router/build/index"
      ],
      "expo-linear-gradient": [
        "./types/expo-linear-gradient/index"
      ],
      "expo-image-picker": [
        "./types/expo-image-picker/index"
      ],
      "expo-status-bar": [
        "./types/expo-status-bar/index"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ],
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
